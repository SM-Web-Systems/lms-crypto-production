{
  "name": "lms-server",
  "version": "1.0.0",
  "description": "Backend server for Student Management System",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:init": "node dist/scripts/initDb.js",
    "db:schema": "node dist/scripts/initDb.js",
    "db:seed": "tsx src/scripts/seedUsers.ts",
    "db:promote-admin": "node dist/scripts/promoteUserToAdmin.js",
    "db:promote-admin:docker": "docker exec lms-api npm run db:promote-admin --",
    "db:seed-courses": "tsx src/scripts/seedCourses.ts",
    "db:seed-solana": "tsx src/scripts/seedSolanaCrashCourse.ts",
    "db:seed-students": "tsx src/scripts/seedStudentsWithCourses.ts",
    "db:migrate": "tsx src/scripts/migrateDocuments.ts",
    "db:migrate-profile": "tsx src/scripts/migrateProfile.ts",
    "db:migrate-course-code": "tsx src/scripts/migrateCourseCodeAccess.ts",
    "db:migrate-clerk": "tsx src/scripts/migrateClerkUserId.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:bvc": "tsx src/scripts/validateBvcContent.ts",
    "test:compiled-bootstrap": "node scripts/test-compiled-bootstrap.mjs",
    "test:restore-drill": "node scripts/synthetic-restore-drill.mjs",
    "rbac:inventory": "node scripts/rbac-inventory.mjs",
    "test:rbac-inventory": "node --test scripts/rbac-inventory.test.mjs scripts/rbac-cutover.test.mjs",
    "rbac:cutover": "node scripts/rbac-cutover.mjs",
    "test:rbac-runtime": "node scripts/test-rbac-runtime.mjs"
  },
  "keywords": [
    "student",
    "management",
    "api",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^16.4.1",
    "@types/qrcode": "^1.5.6",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "isomorphic-dompurify": "3.19.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^18.0.11",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.16.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.12"
  }
}
