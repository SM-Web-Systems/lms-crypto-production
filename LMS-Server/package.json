{
  "name": "lms-server",
  "version": "1.0.0",
  "description": "Backend server for Student Management System",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:init": "tsx src/scripts/initDb.ts",
    "db:schema": "tsx src/scripts/runSchema.ts",
    "db:seed": "tsx src/scripts/seedUsers.ts",
    "db:promote-admin": "tsx src/scripts/promoteUserToAdmin.ts",
    "db:promote-admin:docker": "docker exec lms-api npm run db:promote-admin --",
    "db:seed-courses": "tsx src/scripts/seedCourses.ts",
    "db:seed-solana": "tsx src/scripts/seedSolanaCrashCourse.ts",
    "db:seed-students": "tsx src/scripts/seedStudentsWithCourses.ts",
    "db:migrate": "tsx src/scripts/migrateDocuments.ts",
    "db:migrate-profile": "tsx src/scripts/migrateProfile.ts",
    "db:migrate-course-code": "tsx src/scripts/migrateCourseCodeAccess.ts",
    "db:migrate-clerk": "tsx src/scripts/migrateClerkUserId.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "student",
    "management",
    "api",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^15.1.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.16.0",
    "pino": "^10.3.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.0.18"
  }
}
