# Copy to LMS-Server/.env for local development.
# NEVER commit .env — it is gitignored.
# Production secrets are managed separately (Docker env or secrets manager).

# --- App ---
NODE_ENV=development
PORT=3001

# --- Database ---
# Path relative to LMS-Server/ (better-sqlite3)
DATABASE_PATH=./data/student_ms.db

# --- CORS ---
# URL of the frontend served to browsers (no trailing slash)
FRONTEND_URL=http://localhost:5173

# --- Auth ---
# Generate with: openssl rand -hex 64
JWT_SECRET=

# --- Admin accounts ---
# Comma-separated email addresses granted admin role on first sign-in
ADMIN_EMAILS=admin@yourdomain.com

# --- Lecturer accounts ---
# Comma-separated email addresses granted lecturer role (optional)
LECTURER_EMAILS=

# --- Rate limiting (requests per IP per 15-minute window) ---
# Leave blank to use defaults: API=100, auth=20 (dev: 2000/120)
API_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=

# --- Trust proxy ---
# Set to 1 when behind nginx, Railway, or any reverse proxy
# so X-Forwarded-For is honored for rate limiting
# TRUST_PROXY=1

# --- AmmaWallet integration (server-to-server) ---
# Base URL of the AmmaWallet API (no trailing slash)
AMMA_WALLET_URL=https://ammawallet.com
# Server-to-server API key — must match API_KEYS in AmmaWallet app.env
AMMA_WALLET_API_KEY=
# Stellar network: "public" for mainnet, "testnet" for isolated staging
AMMA_WALLET_NETWORK=public

# --- SSO (AmmaWallet acts as Identity Provider) ---
# Shared HMAC secret — must match SSO_SECRET in AmmaWallet app.env
# Generate with: openssl rand -hex 32
AMMA_SSO_STATE_SECRET=

# --- NFT minting (Soroban contract on Stellar) ---
# Stellar network: required — must be "public" or "testnet".
# Missing or invalid values fail closed (mint operations will not proceed).
NFT_STELLAR_NETWORK=public
# Deployed contract address (C... address) — must match the target network
NFT_CONTRACT_ID=
# Minter wallet PUBLIC key (G... address — NOT the secret)
NFT_MINTER_PUBLIC_KEY=
# Minter wallet SECRET key — NEVER log, print, or commit
NFT_MINTER_SECRET=
# Soroban RPC endpoint (optional — defaults to network-specific URL)
# public: https://mainnet.sorobanrpc.com | testnet: https://soroban-testnet.stellar.org
NFT_SOROBAN_RPC_URL=
# Comma-separated quiz UUIDs that trigger auto-mint (if auto-mint is enabled)
NFT_TRIGGER_QUIZ_IDS=
# "true" to enable quiz-triggered auto-mint (production: keep "false" — use admin panel)
NFT_AUTO_MINT_ENABLED=false

# --- SMTP (nodemailer STARTTLS — Stalwart or external relay) ---
SMTP_HOST=mail.smwebsystems.com
SMTP_PORT=587
# Stalwart principal name (not the full email address)
SMTP_USER=noreply.smwebsystems
# App password — NEVER commit
SMTP_PASS=
EMAIL_FROM=LMS <noreply@smwebsystems.com>
LMS_NAME=SM Web Systems Blockchain Academy
