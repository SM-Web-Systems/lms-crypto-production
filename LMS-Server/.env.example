# Copy to LMS-Server/.env for local development.
# NEVER commit .env — it is gitignored.
# Production secrets are managed separately (Docker env or secrets manager).

# --- App ---
NODE_ENV=development
PORT=3001

# --- Database ---
# Path relative to LMS-Server/ (better-sqlite3)
DATABASE_PATH=./data/student_ms.db

# --- CORS ---
# URL of the frontend served to browsers (no trailing slash)
FRONTEND_URL=http://localhost:5173

# --- Auth ---
# Generate with: openssl rand -hex 64
JWT_SECRET=

# --- Admin accounts ---
# Comma-separated email addresses granted admin role on first sign-in
ADMIN_EMAILS=admin@yourdomain.com

# --- Lecturer accounts ---
# Comma-separated email addresses granted lecturer role (optional)
LECTURER_EMAILS=

# --- Rate limiting (requests per IP per 15-minute window) ---
# Leave blank to use defaults: API=100, auth=20 (dev: 2000/120)
API_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=

# --- Trust proxy ---
# Set to 1 when behind nginx, Railway, or any reverse proxy
# so X-Forwarded-For is honored for rate limiting
# TRUST_PROXY=1

# --- AmmaWallet integration (server-to-server) ---
# Base URL of the AmmaWallet API (no trailing slash)
AMMA_WALLET_URL=https://ammawallet.com
# Server-to-server API key. AUTH-14: this must be the LMS's Amma DB tenant key (scopes
# sso:verify, activation:write, activation:read), not a key from Amma's API_KEYS env list.
# Put the SAME value in AMMA_ACTIVATION_API_KEY. Never log it. To give Amma its hash:
#   printf '%s' "$KEY" | sha256sum | cut -d' ' -f1
AMMA_WALLET_API_KEY=
# Stellar network: "public" for mainnet, "testnet" for isolated staging
AMMA_WALLET_NETWORK=public
# Sign-up wallet: "receive-only" (default) makes a keyless AmmaWallet wallet at registration;
# "off" makes none, and the learner gets an Amma-held wallet later (GET /admin/amma-wallets/needed, then import).
# AMMA_REGISTER_WALLET=receive-only

# --- SSO (AmmaWallet acts as Identity Provider) ---
# Mainnet legacy bindings use no issuer. Testnet requires the exact HTTPS AMMA_WALLET_URL as issuer.
AMMA_SSO_WALLET_NETWORK=mainnet
# AMMA_SSO_ISSUER=https://testnet.ammawallet.com
# The LMS's OWN secret for signing its SSO `state`. It is not used for Amma assertions and must
# NOT equal Amma's SSO_SECRET (AUTH-14). Generate with: openssl rand -hex 32
AMMA_SSO_STATE_SECRET=
# Optional, during a rotation only: the old value, accepted for checking (never signing) state for
# about 10 minutes so in-flight logins finish. Remove after the rotation.
AMMA_SSO_STATE_SECRET_PREVIOUS=
# AUTH-14 browser binding of the SSO state. "required" (default) refuses a callback opened in a
# browser that did not start the login. "optional" is an emergency fallback only: a callback with
# no binding cookie is logged and allowed; a wrong cookie is still refused.
# AMMA_SSO_STATE_BINDING=required
# Opt in to platform/build counts from successful native Wallet exchanges during retirement review.
LMS_NATIVE_WALLET_BUILD_OBSERVATION_ENABLED=false

# --- NFT minting (Soroban contract on Stellar) ---
# Stellar network: required — must be "public" or "testnet".
# Missing or invalid values fail closed (mint operations will not proceed).
NFT_STELLAR_NETWORK=public
# Deployed contract address (C... address) — must match the target network
NFT_CONTRACT_ID=
# Minter wallet PUBLIC key (G... address — NOT the secret)
NFT_MINTER_PUBLIC_KEY=
# Minter wallet SECRET key — NEVER log, print, or commit
NFT_MINTER_SECRET=
# Soroban RPC endpoint (optional — defaults to network-specific URL)
# public: https://mainnet.sorobanrpc.com | testnet: https://soroban-testnet.stellar.org
NFT_SOROBAN_RPC_URL=
# Comma-separated quiz UUIDs that trigger auto-mint (if auto-mint is enabled)
NFT_TRIGGER_QUIZ_IDS=
# "true" to enable quiz-triggered auto-mint (production: keep "false" — use admin panel)
NFT_AUTO_MINT_ENABLED=false

# --- SMTP (nodemailer STARTTLS — Stalwart or external relay) ---
SMTP_HOST=mail.smwebsystems.com
SMTP_PORT=587
# Stalwart principal name (not the full email address)
SMTP_USER=noreply.smwebsystems
# App password — NEVER commit
SMTP_PASS=
EMAIL_FROM=LMS <noreply@smwebsystems.com>
LMS_NAME=SM Web Systems Blockchain Academy
# Reward deposits: explicitly select testnet or public plus an active receiving
# account. Empty values keep Stellar funding unavailable. No signing key needed.
REWARD_STELLAR_NETWORK=
REWARD_STELLAR_DESTINATION=
# Company treasury sending account for public platform backing only. Public G address.
REWARD_TREASURY_SOURCE_ACCOUNT=
# Approved cumulative budget for public-network company-funded platform credit, in integer stroops.
# Empty disables new public pilot grants and learner allocations.
REWARD_TREASURY_PILOT_TOTAL_STROOPS=

# Push delivery: disabled until the matching Expo project, enhanced push security
# access token, signed native builds and device acceptance are configured.
# The access token is server-only. Never use an EXPO_PUBLIC_ variable for it.
PUSH_NOTIFICATIONS_ENABLED=false
EXPO_PUSH_PROJECT_ID=
EXPO_PUSH_ACCESS_TOKEN=
# Web Push for the home-screen web app (iPhone iOS 16.4+, Android, desktop browsers).
# Generate a key pair with: node scripts/generate-vapid-keys.mjs  (keep the private key secret, never commit it)
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ops@example.com

# Offline learning requires an approved list of course IDs and a lease duration of 60–1209600 seconds (14 days; approved 22 Nov 2026).
OFFLINE_LEARNING_ENABLED=false
OFFLINE_LEARNING_COURSE_IDS=
OFFLINE_LEARNING_TTL_SECONDS=

# Set only for a verified Paystack target. The LMS refuses a key in the other mode.
# PAYSTACK_REQUIRED_MODE=test
# Optional timestamped Paystack-Signature verification. Set the current signing
# secret for this Paystack mode once the provider sends the new header.
# Keep the previous secret only during Paystack's rotation overlap.
# PAYSTACK_WEBHOOK_SECRET=
# PAYSTACK_WEBHOOK_PREVIOUS_SECRET=
