{
  "cli": {
    "version": "25.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "22.18.0"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://lms.smwebsystems.com/api/v1",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://lms.smwebsystems.com",
        "EXPO_PUBLIC_AMMA_WALLET_URL": "https://ammawallet.com"
      },
      "node": "22.18.0",
      "autoIncrement": true
    },
    "preview-local-api": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://192.168.10.59:3001/api/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://lms.smwebsystems.com/api/v1",
        "EXPO_PUBLIC_WEB_BASE_URL": "https://lms.smwebsystems.com"
      },
      "node": "22.18.0"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
