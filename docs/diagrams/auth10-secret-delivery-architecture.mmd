flowchart LR
    subgraph SOURCE["Secret Source"]
        ENV_FILE[".env file on host\nPlaintext on disk\nChmod 600"]
    end

    subgraph COMPOSE["Docker Compose"]
        ENV_DIRECTIVE["env_file: .env\nin docker-compose.yml"]
    end

    subgraph CONTAINER["lms-api Container"]
        PROCESS_ENV["process.env\nAll vars injected\nat container start"]
    end

    subgraph CONSUMERS["Secret Consumers"]
        JWT["JWT_SECRET\nToken signing/verification"]
        PAYSTACK["PAYSTACK_SECRET_KEY\nPayment processing"]
        AMMA["AMMA_WALLET_CLIENT_SECRET\nOAuth2 PKCE with IdP"]
        SMTP["SMTP_PASSWORD\nEmail delivery"]
        NFT["NFT_API_KEY\nNFT minting service"]
        DB["DATABASE_URL\nSQLite path config"]
    end

    subgraph RISKS["Visibility Risks"]
        R1["docker inspect\nshows all env vars"]
        R2["/proc/1/environ\nreadable if root"]
        R3["docker compose config\nprints interpolated values"]
        R4["Container escape\nexposes all secrets"]
    end

    subgraph DISPOSITION["Risk Disposition"]
        ACCEPTED["ACCEPTED RISK\nSimplicity over security\nSingle-tenant host\nTrusted operator model"]
    end

    subgraph MITIGATIONS["Possible Future Mitigations"]
        M1["Docker secrets\nswarm-only or compose v2"]
        M2["HashiCorp Vault\nExternal secret manager"]
        M3["SOPS / age\nEncrypted .env at rest"]
    end

    ENV_FILE -->|"read at deploy"| ENV_DIRECTIVE
