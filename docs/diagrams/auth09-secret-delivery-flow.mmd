%% AUTH-09: Environment Configuration and Secret Delivery Flow
%% From .env files through Compose to container process

flowchart TD
    ENV_ROOT[".env (root)<br/>COMPOSE_PROJECT_NAME<br/>FRONTEND_URL<br/>VITE_CLERK_PUBLISHABLE_KEY<br/>perm: 600"]
    ENV_SERVER["LMS-Server/.env<br/>JWT_SECRET, PAYSTACK_SECRET_KEY<br/>AMMA_WALLET_API_KEY, SMTP_PASS<br/>NFT_MINTER_SECRET, etc.<br/>perm: 600"]

    ENV_ROOT -->|"variable substitution"| COMPOSE["docker-compose.yml"]
    ENV_SERVER -->|"env_file directive"| COMPOSE

    COMPOSE -->|"docker compose up"| API_ENV["lms-api container<br/>process.env.*"]
    COMPOSE -->|"build args"| WEB_BUILD["lms-web build stage<br/>VITE_* baked into JS"]

    API_ENV --> APP["Node.js Application<br/>reads process.env.*"]

    subgraph EXPOSURE["Secret Exposure Points"]
        direction LR
        X1["docker inspect<br/>(shows all env vars)"]
        X2["/proc/1/environ<br/>(inside container)"]
        X3["docker compose config<br/>(shows interpolated values)"]
    end

    API_ENV --> X1
    API_ENV --> X2

    subgraph MITIGATIONS["Current Mitigations"]
        direction LR
        M1[".env files: 600 perm"]
        M2[".env gitignored"]
        M3["Docker socket: root-only"]
    end

    subgraph ALTERNATIVES["Future Alternatives"]
        direction LR
        A1["Docker Secrets<br/>(requires Swarm or file mount)"]
        A2["Vault integration<br/>(high complexity)"]
        A3["env-file with restricted<br/>docker socket access"]
    end

    style X1 fill:#f96,stroke:#c60
    style X2 fill:#f96,stroke:#c60
    style X3 fill:#ff9,stroke:#cc0
    style M1 fill:#6f6,stroke:#090
    style M2 fill:#6f6,stroke:#090
