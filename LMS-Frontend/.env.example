# Copy to .env and fill in values. This file is safe to commit (no secrets).

# Backend API (no trailing slash). Local dev:
#   VITE_API_BASE_URL=http://localhost:3001/api/v1
# Docker / same-origin nginx edge build often uses:
#   VITE_API_BASE_URL=/api/v1
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Clerk — publishable key only (safe in the browser). Dashboard: https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Optional: extra dev server / preview hostnames (comma-separated), e.g. tunnels:
#   VITE_DEV_ALLOWED_HOSTS=.ngrok-free.app,your-host.lan
# VITE_DEV_ALLOWED_HOSTS=
