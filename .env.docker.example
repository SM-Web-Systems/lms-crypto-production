# Copy to .env in this folder for docker compose variable substitution.
# NEVER commit .env — it is gitignored.
#
# These values are consumed by docker-compose.yml at runtime.
# Real secrets (JWT_SECRET, SMTP_PASS, etc.) go in LMS-Server/.env,
# which the api container loads via env_file in docker-compose.yml.

# Public URL of the LMS frontend (nginx external URL, no trailing slash)
FRONTEND_URL=https://lms.smwebsystems.com

# Vite build-time API base URL — baked into the web bundle by the Dockerfile ARG.
# Must be /api/v1 when served through nginx (NOT http://localhost:...).
# Changing this requires a full `docker compose build web` to take effect.
VITE_API_BASE_URL=/api/v1
